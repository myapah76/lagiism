# ==============================================================================
# LAGIISM Full-Stack Environment Template (NEVER commit .env)
# ==============================================================================

# Database (PostgreSQL 16)
POSTGRES_DB=lagiism
POSTGRES_USER=lagiism
POSTGRES_PASSWORD=change_me_strong_db_password
DB_URL=jdbc:postgresql://localhost:5432/lagiism
DB_USERNAME=lagiism
DB_PASSWORD=change_me_strong_db_password

# Spring Profile (dev | prod)
SPRING_PROFILES_ACTIVE=dev

# Initial Admin Bootstrap (seeded only if no admin account exists)
ADMIN_EMAIL=admin@lagiism.com
ADMIN_PASSWORD=ChangeMeStrongPassword123!

# CORS Allowed Origins (comma-separated, never '*' with credentials)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# AES-256-GCM Master Key for encrypting SMTP credentials in DB (32-byte UTF-8 or Base64)
ENCRYPTION_KEY=replace_with_32_char_secret_key!

# Cloudinary CDN
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Redis 7 (JWT Blacklist & Refresh Token Store)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication (at least 32 bytes / 256-bit secret for HS256)
JWT_SECRET=replace_with_a_strong_256_bit_jwt_signing_secret_key!
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# Google OAuth2 (Web Client ID from Google Cloud Console)
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Frontend (lagiism-fe)
VITE_API_BASE_URL=http://localhost:8080/api
